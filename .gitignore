# Run outputs are never committed. Results are published in releases with recorded
# provenance, not carried in the working tree — and synthetic self-test output must
# never be mistaken for a finding.
runs/*
!runs/.gitkeep

__pycache__/
*.pyc
.DS_Store
.env
*.local

# Published run data is committed; self-test output is not.
!runs/baseline_*/
!runs/contention_*/
!runs/*.md
!runs/*.txt
!runs/*.gz
runs/_selftest*

# Generated exhibit snapshots; regenerate with docs/provenance/exhibit5.py
exhibit5-*.html
